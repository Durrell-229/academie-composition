# ──────────────────────────────────────────────
# ACADEMIE NUMERIQUE - Configuration Production
# ──────────────────────────────────────────────

# --- DJANGO ---
DJANGO_SECRET_KEY=change-me-to-very-long-random-string-min-50-chars
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com

# --- BASE DE DONNEES ---
# SQLite (development) ou MySQL/PostgreSQL (production)
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
# Pour MySQL en production:
# DB_ENGINE=mysql
# DB_NAME=academie_numerique
# DB_USER=root
# DB_PASSWORD=votre_mot_de_passe
# DB_HOST=localhost
# DB_PORT=3306

# --- IA CONFIGURATION ---
# Providers: groq, gemini, deepseek, mistral
AI_PROVIDER=groq
GROQ_API_KEY=votre_cle_groq
GEMINI_API_KEY=votre_cle_gemini
MISTRAL_API_KEY=votre_cle_mistral
DEEPSEEK_API_KEY=votre_cle_deepseek

# --- MOTS DE PASSE DES ROLES ---
ROLE_PASSWORD_ADMIN=admin2025
ROLE_PASSWORD_CP=cp2026
ROLE_PASSWORD_PROF=prof2026

# --- REDIS (Background Tasks) ---
REDIS_URL=redis://localhost:6379/0

# --- EMAIL (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre_email@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application
DEFAULT_FROM_EMAIL=Academie Numerique <noreply@academie-numerique.com>
