# ============================================================
# ACADÉMIE NUMÉRIQUE — Variables d'environnement PRODUCTION
# À configurer dans le dashboard Render (Environment > Add Variable)
# NE PAS mettre de vraies valeurs dans ce fichier.
# ============================================================

# ── DJANGO ───────────────────────────────────────────────────
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire-de-50-caracteres-minimum

DEBUG=False

# Domaine Render : votre-app.onrender.com (ajouté automatiquement par settings.py)
# Si domaine personnalisé : ajouter aussi ici
ALLOWED_HOSTS=votre-app.onrender.com

# ── BASE DE DONNÉES ───────────────────────────────────────────
# Option A — PostgreSQL Render (recommandé prod)
DB_ENGINE=postgresql
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B — SQLite (acceptable pour petites écoles, 1 seule instance)
# DB_ENGINE=sqlite3
# DB_NAME=db.sqlite3

# ── IA CONFIGURATION ─────────────────────────────────────────
# Au moins UN provider requis — Groq est gratuit et rapide
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Providers alternatifs (fallback automatique)
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# NVIDIA OCR (reconnaissance des copies papier scannées)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── MOTS DE PASSE DES RÔLES ──────────────────────────────────
# Choisir des mots de passe forts pour la production
ROLE_PASSWORD_ADMIN=choisir-un-mot-de-passe-fort
ROLE_PASSWORD_CP=choisir-un-mot-de-passe-fort
ROLE_PASSWORD_PROF=choisir-un-mot-de-passe-fort

# ── EMAIL — RESEND (gratuit 3000 emails/jour) ────────────────
# 1. Créer un compte sur resend.com
# 2. Vérifier votre domaine dans Resend
# 3. Générer une API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=Académie Numérique <noreply@votre-domaine.com>

# ── FEDAPAY — PAIEMENTS MOBILE MONEY ────────────────────────
# Récupérer les clés sur : app.fedapay.com > Settings > API Keys
# Pour les tests : utiliser sandbox. Pour les écoles : utiliser production.
FEDAPAY_ENVIRONMENT=production
FEDAPAY_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEDAPAY_SECRET_KEY=fedapay_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Prix correction unitaire en XOF (0 = gratuit, pas de paywall)
PRIX_CORRECTION_UNITAIRE=500

# ── STOCKAGE FICHIERS — CLOUDINARY (gratuit 25GB) ────────────
# 1. Créer un compte sur cloudinary.com
# 2. Copier le CLOUDINARY_URL depuis le dashboard
USE_CLOUDINARY_STORAGE=True
CLOUDINARY_URL=cloudinary://123456789:abcdefghij@votre-cloud-name

# ── URLS & DOMAINE ───────────────────────────────────────────
SITE_URL=https://votre-app.onrender.com

# ── REDIS (optionnel — threads daemon utilisés si absent) ────
# Laisser vide sur Render gratuit (pas de Redis gratuit)
REDIS_URL=

# ── CORS (si vous avez un frontend séparé) ───────────────────
CORS_ALLOWED_ORIGINS=https://votre-app.onrender.com
