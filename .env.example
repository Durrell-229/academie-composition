# ──────────────────────────────────────────────
# ACADEMIE NUMERIQUE - Configuration Production
# ──────────────────────────────────────────────

# --- DJANGO ---
DJANGO_SECRET_KEY=change-me-to-very-long-random-string-min-50-chars
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com

# --- BASE DE DONNEES ---
# SQLite (development) ou MySQL/PostgreSQL (production)
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
# Pour MySQL en production:
# DB_ENGINE=mysql
# DB_NAME=academie_numerique
# DB_USER=root
# DB_PASSWORD=votre_mot_de_passe
# DB_HOST=localhost
# DB_PORT=3306

# --- IA CONFIGURATION ---
# Providers: groq, gemini, deepseek, mistral
AI_PROVIDER=groq
GROQ_API_KEY=votre_cle_groq
GEMINI_API_KEY=votre_cle_gemini
MISTRAL_API_KEY=votre_cle_mistral
DEEPSEEK_API_KEY=votre_cle_deepseek

# --- MOTS DE PASSE DES ROLES ---
ROLE_PASSWORD_ADMIN=admin2025
ROLE_PASSWORD_CP=cp2026
ROLE_PASSWORD_PROF=prof2026

# --- REDIS (Background Tasks) ---
REDIS_URL=redis://localhost:6379/0

# --- EMAIL (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre_email@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application
DEFAULT_FROM_EMAIL=Academie Numerique <noreply@academie-numerique.com>


# Configuration NVIDIA OCR
NVIDIA_API_KEY = os.getenv('NVIDIA_API_KEY', '')  # Votre clé API NVIDIA gratuite
NVIDIA_OCR_MODEL = 'nvidia/ocr-0.1'  # Modèle OCR gratuit et performant
NVIDIA_OCR_MAX_FILE_SIZE = 10 * 1024 * 1024  # 10MB

# ──────────────────────────────────────────────
# FEDAPAY - PAIEMENTS EN LIGNE
# ──────────────────────────────────────────────

# Mode: sandbox (test) ou production (live)
FEDAPAY_ENV=production

# Clé publique (visible côté client) - Fournie par FedaPay
# Déjà configurée: pk_live_X_DmtE7HnbtVA7i1nmjgcXJ0
FEDAPAY_PUBLIC_KEY=pk_live_X_DmtE7HnbtVA7i1nmjgcXJ0

# Clé secrète (NE JAMAIS EXPOSER) - À récupérer sur dashboard.fedapay.com
FEDAPAY_SECRET_KEY=sk_live_VOTRE_CLE_SECRETE_ICI

# Secret pour vérifier les webhooks (générer une chaîne aléatoire)
FEDAPAY_WEBHOOK_SECRET=whsec_votre_secret_webhook_aleatoire

# URL de votre site (pour les callbacks)
SITE_URL=https://votre-domaine.com
NVIDIA_OCR_TIMEOUT = 30  # secondes

# Configuration OCR avancée
OCR_CONFIDENCE_THRESHOLD = 70  # Seuil de confiance minimum
OCR_LANGUAGES = ['fr', 'en', 'es', 'ar', 'pt']  # Langues supportées
OCR_PREPROCESSING_ENABLED = True  # Prétraitement des images
OCR_BATCH_SIZE = 5  # Nombre de fichiers traités en parallèle
