# ============================================================
# VARIABLES D'ENVIRONNEMENT POUR RENDER
# Copie depuis .env.local — À configurer dans Render Dashboard
# ============================================================

# ─── DJANGO ──────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production-very-secret-key-2025-numerique-ia
DEBUG=False
ALLOWED_HOSTS=*.onrender.com,votre-domaine.com

# ─── BASE DE DONNÉES ──────────────────────────
# Render crée automatiquement DATABASE_URL
DB_ENGINE=postgresql

# ─── IA PROVIDERS ──────────────────────────────
AI_PROVIDER=groq
GROQ_API_KEY=VOTRE_CLE_GROQ_ICI
GEMINI_API_KEY=VOTRE_CLE_GEMINI_ICI
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL_ICI
DEEPSEEK_API_KEY=VOTRE_CLE_DEEPSEEK_ICI

# ─── NVIDIA OCR ────────────────────────────────
# ⚠️  CLÉE TROUVÉE DANS .env LOCAL
NVIDIA_API_KEY=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

# ─── MOTS DE PASSE DES RÔLES ───────────────────
ROLE_PASSWORD_ADMIN=admin2025
ROLE_PASSWORD_CP=cp2026
ROLE_PASSWORD_PROF=prof2026

# ─── EMAIL (Resend) ────────────────────────────
RESEND_API_KEY=VOTRE_CLE_RESEND_ICI
DEFAULT_FROM_EMAIL=Académie Numérique <noreply@votre-domaine.com>

# ─── PAIEMENTS (FedaPay) ────────────────────────
# ⚠️  EN MODE SANDBOX DANS .env LOCAL
# Changer en PRODUCTION pour Render!
FEDAPAY_ENVIRONMENT=production
FEDAPAY_PUBLIC_KEY=pk_live_VOTRE_CLE_PUBLIQUE
FEDAPAY_SECRET_KEY=sk_live_VOTRE_CLE_SECRETE
FEDAPAY_WEBHOOK_SECRET=VOTRE_SECRET_WEBHOOK

# Prix correction unitaire (0 = gratuit)
PRIX_CORRECTION_UNITAIRE=0

# ─── REDIS (Auto-lié par Render) ───────────────
# Render crée automatiquement REDIS_URL
# Ne pas configurer manuellement

# ─── CLOUDINARY ────────────────────────────────
USE_CLOUDINARY_STORAGE=True
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─── CORS ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://votre-app.onrender.com

# ─── SÉCURITÉ ──────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
