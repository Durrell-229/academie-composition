# ============================================================
# .env.render — Template pour configuration Render
# NE PAS mettre de vraies valeurs ici !
# À copier dans le dashboard Render → Environment variables
# ============================================================

# ──────────────────────────────────────────────────────────
# DJANGO CONFIGURATION
# ──────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=auto-generated-by-render
DEBUG=False
ALLOWED_HOSTS=*.onrender.com,votre-domaine-personnalise.com
SITE_URL=https://votre-app.onrender.com

# ──────────────────────────────────────────────────────────
# BASE DE DONNÉES — PostgreSQL (Render gère les liens)
# ──────────────────────────────────────────────────────────
DB_ENGINE=postgresql
DATABASE_URL=auto-linked-from-render-postgres-service

# ──────────────────────────────────────────────────────────
# CACHE & SESSION — Redis (Render gère les liens)
# ──────────────────────────────────────────────────────────
REDIS_URL=auto-linked-from-render-redis-service
CHANNEL_LAYERS_REDIS=auto-linked-from-render-redis-service

# ──────────────────────────────────────────────────────────
# IA PROVIDERS — Au moins UN requis (Groq est gratuit)
# ──────────────────────────────────────────────────────────
AI_PROVIDER=groq

# Groq (gratuit, rapide) — https://console.groq.com/keys
GROQ_API_KEY=<VOTRE_CLE_GROQ_ICI>

# Google Gemini (gratuit) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<VOTRE_CLE_GEMINI_ICI>

# Mistral (payant) — https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=<VOTRE_CLE_MISTRAL_ICI>

# DeepSeek (payant) — https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=<VOTRE_CLE_DEEPSEEK_ICI>

# ──────────────────────────────────────────────────────────
# NVIDIA OCR — Reconnaissance optique (copie scannée)
# ──────────────────────────────────────────────────────────
NVIDIA_API_KEY=<VOTRE_CLE_NVIDIA_ICI>

# ──────────────────────────────────────────────────────────
# EMAIL — Resend (3000 emails/jour gratuit)
# ──────────────────────────────────────────────────────────
# 1. Créer compte : https://resend.com
# 2. Vérifier domaine
# 3. Copier la clé API
RESEND_API_KEY=<VOTRE_CLE_RESEND_ICI>
DEFAULT_FROM_EMAIL="Académie Numérique <noreply@academie-numerique.com>"

# ──────────────────────────────────────────────────────────
# PAIEMENTS — FedaPay (Mobile Money Bénin)
# ──────────────────────────────────────────────────────────
# Dashboard : https://app.fedapay.com/settings/api-keys
FEDAPAY_ENVIRONMENT=production
FEDAPAY_PUBLIC_KEY=<VOTRE_CLE_PUBLIQUE_FEDAPAY_ICI>
FEDAPAY_SECRET_KEY=<VOTRE_CLE_SECRETE_FEDAPAY_ICI>
FEDAPAY_WEBHOOK_SECRET=<VOTRE_SECRET_WEBHOOK_FEDAPAY_ICI>

# Prix unitaire correction en XOF (0 = gratuit)
PRIX_CORRECTION_UNITAIRE=500

# ──────────────────────────────────────────────────────────
# STOCKAGE FICHIERS — Cloudinary (25GB gratuit)
# ──────────────────────────────────────────────────────────
# 1. Créer compte : https://cloudinary.com
# 2. Dashboard → Settings → Copy CLOUDINARY_URL
# Laisser USE_CLOUDINARY_STORAGE=True
USE_CLOUDINARY_STORAGE=True
CLOUDINARY_URL=<VOTRE_CLOUDINARY_URL_ICI>

# ──────────────────────────────────────────────────────────
# RÔLES — Mots de passe initiaux (changer après déploiement)
# ──────────────────────────────────────────────────────────
ROLE_PASSWORD_ADMIN=ChoisirMotDePasseFortPour123Admin!
ROLE_PASSWORD_CP=ChoisirMotDePasseFortPour123CP!
ROLE_PASSWORD_PROF=ChoisirMotDePasseFortPour123Prof!

# ──────────────────────────────────────────────────────────
# CORS — Cross-Origin Resource Sharing
# ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://votre-app.onrender.com,https://votre-domaine.com

# ──────────────────────────────────────────────────────────
# SÉCURITÉ HTTPS — À activer en production
# ──────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ──────────────────────────────────────────────────────────
# LOGS & MONITORING (optionnel)
# ──────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=  # Optionnel : pour error tracking sur Sentry

# ──────────────────────────────────────────────────────────
# NOTES DE CONFIGURATION
# ──────────────────────────────────────────────────────────
# 1. DJANGO_SECRET_KEY :
#    Render génère automatiquement via generateValue: true
#    Si manuel : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# 2. DATABASE_URL & REDIS_URL :
#    Render crée automatiquement les variables à partir des services
#    Liés via fromService/fromDatabase dans render.yaml

# 3. API KEYS :
#    Ne JAMAIS commiter de vraies clés
#    Les ajouter uniquement via le dashboard Render
#    Ou utiliser un .env.render.local en développement

# 4. DOMAINE PERSONNALISÉ :
#    - Acheter un domaine (ex: Namecheap, Gandi, etc)
#    - Render → Service → Custom Domain
#    - Ajouter les enregistrements DNS pointant vers Render

# 5. WEBHOOKS FEDAPAY :
#    - FedaPay → Webhooks → Add webhook
#    - URL : https://votre-app.onrender.com/api/webhooks/fedapay/
#    - Events : transaction.approved, transaction.failed

# ──────────────────────────────────────────────────────────
# CHECKLIST : À FAIRE AVANT DÉPLOIEMENT
# ──────────────────────────────────────────────────────────
# [ ] Créer compte Render.com
# [ ] Créer repository GitHub avec ce code
# [ ] Connexion Render ↔ GitHub autorisée
# [ ] render.yaml, Procfile, render-build.sh présents
# [ ] Variables d'environnement copiées dans Render UI
# [ ] Clés API configurées (Groq minimum)
# [ ] Services créés (Web, Worker, Beat, Redis, PostgreSQL)
# [ ] Domaine .onrender.com fonctionnel
# [ ] Tests post-déploiement réussis
# [ ] Monitoring configuré (Render alerts)
# [ ] Backups programmés (Render PostgreSQL)
